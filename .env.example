# Anthropic model key for extraction, scoring, chat, and drafting; model lanes stay disabled without it
ANTHROPIC_API_KEY=

# Exa hosted MCP server key (mcp.exa.ai/mcp) for the scouting agent; scout renders disabled without it
EXA_API_KEY=

# Apollo MCP OAuth access token for company and people enrichment; optional, scout works without it
APOLLO_MCP_TOKEN=

# Affinity API key for CRM context reads; the Affinity panel renders disabled without it
AFFINITY_API_KEY=

# Attio hosted MCP OAuth access token (mcp.attio.com/mcp) for CRM context and click-gated note write-back
ATTIO_MCP_TOKEN=

# Google SSO OIDC client for sign-in; the seeded dev session is used while these are empty
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local infrastructure; defaults match compose.yaml
MONGODB_URI=mongodb://127.0.0.1:27017/fundos
CLICKHOUSE_URL=http://127.0.0.1:8123
REDIS_URL=redis://127.0.0.1:6379
