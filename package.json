{
  "name": "fundos",
  "private": true,
  "version": "0.1.0",
  "description": "The LP-defensible system-of-record for AI-influenced investment decisions",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tests",
    "test": "vitest run tests/unit",
    "e2e": "vitest run tests/e2e",
    "fixtures": "node fixtures/generate.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "pdf-lib": "^1.17.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
